@model MonitoringTimelineViewModel

<h1>Přehrávání</h1>

<form method="get" asp-action="Index" class="d-flex gap-2 align-items-center mb-3">
    <label for="inputDate" class="form-label mb-0">Datum</label>
    <input id="inputDate"
           type="date"
           name="selectedDate"
           value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
           class="form-control w-auto"
           onchange="this.form.submit()" />
</form>

@if (Model.Segments.Count == 0)
{
    <div class="alert alert-warning">
        Pro tento den nejsou žádné záznamy.
    </div>
}
else
{
    <video id="recordPlayer" controls class="w-100 rounded shadow-sm mb-3">
        <source src="@Url.Action("Video", "Monitoring", new { fileName = Model.Segments.First().FileName })" type="video/mp4" />
    </video>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Časová osa</h5>

            <div class="timeline-grid">
                @foreach (var slot in Model.Slots)
                {
                    var cssClass = "timeline-slot-empty";

                    if (slot.HasRecording)
                    {
                        cssClass = slot.HasMotion
                        ? "timeline-slot-motion"
                        : "timeline-slot-recording";
                    }

                    <button type="button"
                            class="timeline-slot @cssClass"
                            title="@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")"
                            disabled="@(!slot.HasRecording)"
                            onclick="playSegment('@slot.FileName', this)">
                    </button>
                }
            </div>

            <div class="d-flex justify-content-between small text-muted mt-1">
                <span>00:00</span>
                <span>06:00</span>
                <span>12:00</span>
                <span>18:00</span>
                <span>24:00</span>
            </div>

            <div class="d-flex gap-3 small mt-3">
                <span><span class="legend-box bg-recording"></span> Záznam</span>
                <span><span class="legend-box bg-motion"></span> Pohyb</span>
                <span><span class="legend-box bg-empty"></span> Bez záznamu</span>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function playSegment(fileName, button) {
            if (!fileName) {
                return;
            }

            document
                .querySelectorAll(".timeline-slot")
                .forEach(x => x.classList.remove("timeline-slot-active"));

            button.classList.add("timeline-slot-active");

            const player = document.getElementById('recordPlayer');
            player.src = `/Monitoring/Video?fileName=${encodeURIComponent(fileName)}`;
            player.load();
            player.play();
        }
    </script>
}