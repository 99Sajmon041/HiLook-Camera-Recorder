@model MonitoringTimelineViewModel

<h1>Přehrávání</h1>

<form method="get" asp-action="Index" class="d-flex gap-2 align-items-center mb-3">
    <label for="inputDate" class="form-label mb-0">Datum</label>
    <input id="inputDate" type="date" name="selectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control w-auto" onchange="this.form.submit()" />
</form>

@if (Model.Segments.Count == 0)
{
    <div class="alert alert-warning">
        Pro tento den nejsou žádné záznamy.
    </div>
}
else
{
    <video id="recordPlayer" controls class="w-100 rounded shadow-sm mb-3">
        <source src="@Url.Action("Video", "Monitoring", new { fileName = Model.Segments.First().FileName })" type="video/mp4" />
    </video>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Časová osa</h5>

            <div class="timeline">
                @foreach (var segment in Model.Segments)
                {
                    var dayStart = Model.SelectedDate.ToDateTime(TimeOnly.MinValue);
                    var left = (segment.StartTime - dayStart).TotalMinutes / 1440 * 100;
                    var width = (segment.EndTime - segment.StartTime).TotalMinutes / 1440 * 100;

                    <button type="button"
                            class="timeline-segment"
                            style="left:@left.ToString(System.Globalization.CultureInfo.InvariantCulture)%; width:@width.ToString(System.Globalization.CultureInfo.InvariantCulture)%"
                            title="@segment.StartTime.ToString("HH:mm:ss") - @segment.EndTime.ToString("HH:mm:ss")"
                            onclick="playSegment('@segment.FileName')">
                    </button>
                }

                @foreach (var motion in Model.MotionEvents)
                {
                    var dayStart = Model.SelectedDate.ToDateTime(TimeOnly.MinValue);
                    var left = (motion.DetectedAt - dayStart).TotalMinutes / 1440 * 100;

                    <div class="timeline-motion"
                         style="left:@left.ToString(System.Globalization.CultureInfo.InvariantCulture)%"
                         title="Pohyb: @motion.DetectedAt.ToString("HH:mm:ss") / @motion.DifferencePercent.ToString("F2")%">
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between small text-muted mt-1">
                <span>00:00</span>
                <span>06:00</span>
                <span>12:00</span>
                <span>18:00</span>
                <span>24:00</span>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function playSegment(fileName) {
            const player = document.getElementById('recordPlayer');
            player.src = `/Monitoring/Video?fileName=${encodeURIComponent(fileName)}`;
            player.load();
            player.play();
        }
    </script>
}