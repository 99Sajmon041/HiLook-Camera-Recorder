@model RecordingListViewModel

<h1>Záznamy</h1>

<form method="get" asp-action="Index" class="d-flex gap-2 align-items-center mb-3">
    <label for="inputDate" class="form-label mb-0">Datum záznamů</label>
    <input id="inputDate" type="date" name="selectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control w-auto" onchange="this.form.submit()" />
    <input type="hidden" name="page" value="1" />
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Název souboru</th>
            <th>Vytvořeno</th>
            <th>Velikost (MB)</th>
            <th>Délka (minuty)</th>
            <th>Akce</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Records.Items.Count > 0)
        {
            @foreach (var item in Model.Records.Items)
            {
                <tr>
                    <td>@item.FileName</td>
                    <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>@(item.SizeBytes / 1024 / 1024) MB</td>
                    <td>@item.DurationTime.ToString("HH:mm")</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Monitoring" asp-action="Detail" asp-route-fileName="@item.FileName">
                                Přehrát
                            </a>

                            <form method="post" asp-controller="Monitoring" asp-action="Delete" asp-route-fileName="@item.FileName" asp-route-date="@item.CreatedAt.ToString("yyyy-MM-dd")" onsubmit="return confirm('Opravdu chcete smazat tento záznam?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Smazat
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">
                    <div class="bg-warning text-dark p-2 rounded">
                        Žádné záznamy pro tento den.
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Records.TotalItems > Model.Records.PageSize)
{
    var pages = Model.Records.PagesCount;
    var current = Model.Records.Page;

    var pageNumbers = pages <= 10
        ? Enumerable.Range(1, pages)
        : new[] { 1, current - 1, current, current + 1, pages }
            .Where(x => x >= 1 && x <= pages)
            .Distinct()
            .OrderBy(x => x);

    <nav class="d-flex justify-content-center mt-3">
        <ul class="pagination">

            <li class="page-item @(Model.Records.CanGoPrevious ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(current - 1)"
                   asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")">
                    Předchozí
                </a>
            </li>

            @foreach (var pageNumber in pageNumbers)
            {
                <li class="page-item @(pageNumber == current ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@pageNumber"
                       asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")">
                        @pageNumber
                    </a>
                </li>
            }

            <li class="page-item @(Model.Records.CanGoNext ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(current + 1)"
                   asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")">
                    Další
                </a>
            </li>

        </ul>
    </nav>
}